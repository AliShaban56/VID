# Turso database connection (set in Vercel Environment Variables for production)
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-auth-token

# Optional local server settings
PORT=3000
APP_ACCESS_PASSWORD=choose-a-long-private-password
APP_SESSION_SECRET=generate-a-long-random-secret
KIE_API_KEYS=[{"label":"Primary","secret":"your-kie-api-key"}]
